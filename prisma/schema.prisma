generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}


model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}


model ServiceKey {
  id       String @id @default(cuid())
  user     User   @relation("UserServiceKeys", fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  service  String // e.g. "calendar", "zoom", "github", "openai"
  keys     Json // e.g. { "apiKey": "encrypted...", "calendarId": "encrypted..." }
  metadata Json? // optional: additional info like { "scopes": [...], "lastVerified": "..." }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ensure one service key per user per service
  @@unique([userId, service])
  @@map("service_keys")
}


enum UserRole {
  ADMIN
  TUTOR
  STUDENT
}


model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  role UserRole @default(STUDENT)

  accounts    Account[]
  sessions    Session[]
  serviceKeys ServiceKey[] @relation("UserServiceKeys")

  // Role-specific profiles ...
  tutorProfile   TutorProfile?
  studentProfile StudentProfile?
  adminProfile   AdminProfile?
}


model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  permissions String[] // Admin permissions

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TutorInvitation {
  id          String   @id @default(cuid())
  email       String
  invitationId String  @unique // The special ID used in the URL slug
  used        Boolean  @default(false)
  usedAt      DateTime?
  usedBy      String?  // userId who used it
  createdBy   String   // admin userId who created it
  
  createdAt   DateTime @default(now())
  expiresAt   DateTime? // Optional: expiration date
  
  @@index([invitationId])
  @@index([email])
  @@map("tutor_invitations")
}

model TutorProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  bio        String?
  hourlyRate Decimal? @db.Decimal(10, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tutorSubscriptions TutorSubscription[]
  tutorRequests      TutorRequest[]

  availability Json? // e.g. { "monday": ["10:00", "14:00"], "tuesday": ["09:00", "13:00"] }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum StudentLevel {
  BEGINNER 
  INTERMEDIATE 
  EXPERT
}



model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tutorSubscriptions TutorSubscription[]
  tutorRequests      TutorRequest[]
  moduleSubscriptions ModuleSubscription[]

  notes            Note[]

  level    StudentLevel   @default(BEGINNER)
  bio      String         @default("")
  countryCode String      @default("") // e.g. "US", "GB", "DE"
  skills   String[]       @default([])
  goals    String         @default("")
  streak   Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model ModuleSubscription {
  id         String   @id @default(cuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module     ModuleType 
  expiresAt  DateTime? // null = permanent
  createdAt  DateTime @default(now())

  @@index([studentId])
}


enum ModuleType {
  CREATING
  TOPICS
  CHALLENGES
  COHORTS
  JOURNEYS
  MODULE_HOMEWORK
}


enum TutorRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}


model TutorRequest {
  id String @id @default(cuid())
  studentProfileId String
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  tutorProfileId String
  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  
  status TutorRequestStatus @default(PENDING)
  
  requestAt DateTime @default(now())
  respondedAt DateTime? // When tutor accepts/rejects
  cancelledAt DateTime? // When student cancels
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Prevent duplicate requests of the same status between same student-tutor pair
  // This allows retries after rejection while preventing duplicate pending requests
  @@unique([studentProfileId, tutorProfileId, status])
  @@index([tutorProfileId, status])
  @@index([studentProfileId, status])
}


model TutorSubscription {
  id String @id @default(cuid())

  tutorProfileId String
  tutor          TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  studentProfileId String
  student          StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)


  homework   Homework[]
  sessions   TutoringSession[]

  assignedAt DateTime         @default(now())
  endedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tutorProfileId])
  @@index([studentProfileId])
  @@unique([tutorProfileId, studentProfileId]) // One active subscription per tutor-student pair
}



enum SessionLength {
  MIN60
  MIN90
  MIN120
}


model TutoringSession {
  id          String         @id @default(cuid())
  title       String
  description String?

  // who
  tutorSubscriptionId String
  tutorSubscription   TutorSubscription @relation(fields: [tutorSubscriptionId], references: [id], onDelete: Cascade)

  // when
  startTime  DateTime
  length     SessionLength  @default(MIN60)

  // housekeeping
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([startTime])
}


enum HomeworkStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  RETURNED
  COMPLETED
  CANCELLED
}


model Homework {
  id          String          @id @default(cuid())
  title       String
  description String?

  // 👇 the single relation you care about
  tutorSubscriptionId String
  tutorSubscription   TutorSubscription @relation(fields: [tutorSubscriptionId], references: [id], onDelete: Cascade)

  // store your structured homework content
  tasks Json

  // workflow tracking
  status      HomeworkStatus @default(ASSIGNED)
  dueDate     DateTime?
  submittedAt DateTime?
  gradedAt    DateTime?

  // optional grading + notes
  grade     Decimal? @db.Decimal(5, 2)
  feedback  String?
  metadata  Json? // optional extra info like { version, tags, etc. }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tutorSubscriptionId])
  @@index([status])
  @@index([dueDate])
}


model Note {
  id          String   @id @default(cuid())
  title       String
  content     Json     // structured data from your editor (Editor.js, etc.)
  summary     String?  // optional short summary for previews
  tags        String[] @default([])      // optional tags like ["react", "arrays"]

  // 🔗 relations
  studentProfileId  String
  studentProfile    StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  // 🕓 timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentProfileId])
}


model Inspiration {
  id        String   @id @default(cuid())
  title     String   // title of the inspiration
  content   Json     // structured content for the inspiration (e.g. text, images)
  sourceUrl String?  // optional source of the inspiration
  tags      String[] @default([]) // e.g. ["motivation", "study", "focus"]
  type      String?  // e.g. "quote", "tip", "story"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Project {
  id          String   @id @default(cuid())
  slug        String   @unique

  title       String
  description String?
  content     Json?
  guide       Json?
  estHours    Int
  color       String?

  tags        String[] @default([])
  categories  ProjectCategory[]
  languages   ProjectLanguage[]

  difficulty  Difficulty? @relation(fields: [difficultyId], references: [id], onDelete: SetNull)
  difficultyId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model ProjectCategory {
  projectId String
  categoryId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([projectId, categoryId])
}


model ProjectLanguage {
  projectId String
  languageId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([projectId, languageId])
}


model ChallengeGroup {
  id          String    @id @default(cuid())
  key         String    @unique
  title       String
  description String?
  color       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  challenges  Challenge[]
  subgroups   ChallengeSubGroup[]
}


model ChallengeSubGroup {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String?

  groupId     String
  group       ChallengeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  challenges  Challenge[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}



model Challenge {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String
  estMins      Int
  recommended  Boolean  @default(false)
  tags         String[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  work         Json
  guide        Json

  // Must belong to a group
  groupId      String
  group        ChallengeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // May belong to a subgroup
  subGroupId   String?
  subGroup     ChallengeSubGroup? @relation(fields: [subGroupId], references: [id], onDelete: Cascade)

  // category
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // difficulty
  difficultyId String?
  difficulty   Difficulty? @relation(fields: [difficultyId], references: [id], onDelete: SetNull)

  // languages
  languages    ChallengeLanguage[]
}


//
// Many-to-many join table for Challenge ↔ Language
//

model ChallengeLanguage {
  challengeId String
  languageId  String

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  language    Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([challengeId, languageId])
}


//
// Challenge Units — steps, tasks, sections.
//

model Category {
  id          String   @id @default(cuid())
  key         String   @unique   // stable internal name: SystemDesign, Frontend, etc.
  title       String
  description String

  icon        String?
  color       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  challenges  Challenge[]
  topics      TopicCategory[]
  projects    ProjectCategory[]
}


model Difficulty {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String?
  order       Int       @default(1)

  challenges  Challenge[]
  projects    Project[]
}


model Language {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String?

  icon        String?
  color       String?

  challenges  ChallengeLanguage[]
  topics      TopicLanguage[]
  projects    ProjectLanguage[]
}


model Concept {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics      Topic[]
}


model Topic {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  estMins     Int?
  recommended Boolean  @default(false)
  tags        String[] @default([])

  content     Json?
  blockData   Json?
  guide       Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conceptId   String
  concept     Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  languages    TopicLanguage[]
  categories   TopicCategory[]

  // ⬇️ NEW — all blocks attached to this topic
  blocks       TopicBlock[]
}



model TopicLanguage {
  topicId    String
  languageId String

  topic    Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([topicId, languageId])
}



model TopicCategory {
  topicId    String
  categoryId String

  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([topicId, categoryId])
}


model Block {
  id          String   @id @default(cuid())
  type        String   // "quiz", "animatedCodeChallenge"
  title       String
  description String?
  summary     String?
  data        Json

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ⬇️ NEW — all topics that use this block
  topics      TopicBlock[]
}

model TopicBlock {
  id        String   @id @default(cuid())
  summary   String?

  // Useful for sorting blocks inside a topic
  order     Int      @default(0)

  // → Block
  blockId   String
  block     Block   @relation(fields: [blockId], references: [id], onDelete: Cascade)

  // → Topic
  topicId   String
  topic     Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([blockId, topicId])   // Prevent duplicate links
  @@index([topicId, order])      // For fast ordering
}